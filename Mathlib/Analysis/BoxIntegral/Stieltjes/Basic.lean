@[simp]
lemma BoundedVariationOn.ofSubsingleton {α : Type*} [LinearOrder α] {E : Type*}
[PseudoEMetricSpace E] {f : α → E} {s : Set α} (h : s.Subsingleton) : BoundedVariationOn f s := by
